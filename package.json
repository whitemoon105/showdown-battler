{
  "name": "showdown-battler",
  "version": "0.5.7",
  "description": "Showdown对战器 · 账号、战绩与随机对战",
  "main": "electron/play-main.cjs",
  "author": "白月遥",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/team-editor.e2e.cjs",
    "test:battle": "node tests/battle-presentation.e2e.cjs",
    "test:doubles": "node tests/doubles.e2e.cjs"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "electron-updater": "^6.8.9",
    "pokemon-showdown": "file:artifacts/pokemon-showdown-0.11.11.tgz",
    "undici": "^7.16.0"
  },
  "build": {
    "appId": "cn.dafeiyu.showdownbattler",
    "productName": "ShowdownBattler",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "core/**",
      "ui/**",
      "assets/**",
      "package.json",
      "README.md",
      "THIRD_PARTY.md",
      "LICENSE"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Showdown对战器",
      "artifactName": "ShowdownBattler-Setup-${version}-${arch}.${ext}",
      "include": "scripts/installer.nsh",
      "runAfterFinish": false
    },
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "publish": {
      "provider": "github",
      "owner": "whitemoon105",
      "repo": "showdown-battler",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/whitemoon105/showdown-battler.git"
  },
  "homepage": "https://github.com/whitemoon105/showdown-battler"
}
